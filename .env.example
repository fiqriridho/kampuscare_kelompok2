# =============================================================================
# KampusCare Mobile & Web Frontend Environment Configuration
# =============================================================================
# Variabel yang diakses di kode frontend Expo WAJIB memiliki awalan EXPO_PUBLIC_
# Jangan menyimpan secret atau API key privat di file ini.
#
# Petunjuk Konfigurasi Base URL Backend:
# -----------------------------------------------------------------------------
# 1. Expo Web (Pengujian via Browser di PC/Laptop):
#    Gunakan localhost:
#    EXPO_PUBLIC_API_URL=http://localhost:3000
#
# 2. Android Emulator (Android Studio / AVD):
#    Gunakan IP alias host Android emulator:
#    EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
#
# 3. HP Android Fisik (Expo Go via Wi-Fi):
#    Gunakan IP lokal komputer Anda pada jaringan Wi-Fi yang sama (cek 'ipconfig' di CMD/PowerShell):
#    EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
# =============================================================================

EXPO_PUBLIC_API_URL=http://localhost:3000
